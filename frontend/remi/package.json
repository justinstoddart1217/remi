{
  "name": "remi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../contracts/remi-openapi.json -o src/api/schema.d.ts",
    "subset-icons": "sh scripts/subset-icons.sh",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "openapi-fetch": "^0.17.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-router": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.8",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
